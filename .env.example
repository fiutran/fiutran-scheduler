# Real calendar sync for "you" (optional). Without these, the app runs on sample data only.
# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.

# Encrypts the sign-in cookies (any long random string, e.g. `openssl rand -base64 32`). Needed for either calendar.
AUTH_SECRET=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook / Microsoft 365 (Microsoft Entra app registration)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional. "common" (default) allows personal and work/school accounts.
MICROSOFT_TENANT=
